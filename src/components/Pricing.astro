---
// Shared plan cards: used on the home page and /pricing.
import { reportCardBullets } from '../data/visibilityReport';
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section id="pricing" class="py-24 px-6 bg-surface/30 scroll-mt-20">
  <div class="max-w-6xl mx-auto text-center">
    <div class="text-sm text-cyan-300 font-mono mb-4">PRICING</div>
    <Heading class="text-3xl md:text-4xl font-bold mb-4 break-words">More Calls and Bookings — At a Price That Makes Sense.</Heading>
    <p class="text-muted mb-16 max-w-xl mx-auto">Want the data and to make the fixes yourself? Start with the report. Want it done for you? Go Full Management.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Rank Labs Visibility Report (report only) -->
      <div class="gradient-border rounded-2xl p-6 sm:p-8 md:p-10 text-left flex flex-col min-w-0">
        <div class="text-sm text-purple-300 font-semibold mb-2">RANK LABS VISIBILITY REPORT</div>
        <div class="text-5xl font-bold mb-1">$399<span class="text-lg text-muted font-normal">/mo</span></div>
        <p class="text-muted text-sm mb-4 break-words">Know where you stand on Google, Maps and AI: SEO plus your AI Optimization on-page score, in one report.</p>
        <p class="text-xs text-muted mb-6 break-words"><span class="text-white font-medium">Month-to-month</span>; no long-term contract.</p>

        <div class="rounded-xl border border-amber-400/40 bg-amber-400/10 p-4 mb-8" role="note">
          <div class="text-xs font-mono font-semibold text-amber-300 mb-1">REPORT ONLY</div>
          <p class="text-sm text-white break-words">You handle all fixes. Rank Labs makes <strong>no changes</strong> to your site.</p>
        </div>

        <ul class="space-y-3 mb-8">
          {reportCardBullets.map((feature) => (
            <li class="flex items-start gap-3 text-sm min-w-0">
              <span class="text-green-400 shrink-0">✓</span> <span class="min-w-0 break-words">{feature}</span>
            </li>
          ))}
        </ul>

        <div class="mt-auto space-y-4">
          <a href="/contact/?plan=rank-labs-visibility-report" class="btn-primary block text-center w-full">Get the Report</a>
          <div class="rounded-xl border border-white/10 bg-white/[0.02] p-4 text-sm">
            <p class="text-muted mb-2 break-words">Rather have us make the fixes for you?</p>
            <a href="/signup/?plan=full_management" class="text-cyan-300 hover:text-cyan-200 font-semibold">Upgrade to Full Management <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>

      <!-- Full Management -->
      <div class="gradient-border rounded-2xl p-6 sm:p-8 md:p-10 text-left relative bg-purple-500/[0.03] flex flex-col min-w-0">
        <div class="text-sm text-cyan-300 font-semibold mb-2">FULL MANAGEMENT</div>
        <div class="text-5xl font-bold mb-1">$1,249<span class="text-lg text-muted font-normal">/mo</span></div>
        <div class="inline-block w-fit text-xs px-3 py-1 mt-3 mb-1 bg-purple-500/20 border border-purple-500/40 rounded-full text-purple-300 font-semibold">FIRST MONTH FREE</div>
        <p class="text-muted text-sm mb-4 break-words">We do the work: we fix what's holding back your calls and bookings, do the ongoing AI Optimization work, and build, host, and maintain your site. You approve. We handle the rest.</p>
        <p class="text-xs text-muted mb-8 pb-6 border-b border-white/5 break-words"><span class="text-white font-medium">First month free and the $999 migration fee waived with a 6-month contract</span>; otherwise month-to-month plus a $999 migration fee.</p>

        <ul class="space-y-3 mb-8">
          {[
            'Weekly AI Optimization on-page scoring',
            'Weekly SEO audit reports (100+ checks)',
            'Keyword & competitor tracking',
            'Monthly email report (first week of each month): your Google search, Business Profile, traffic, leads & AI Optimization score vs. last month, plus the work we delivered',
            'AI Optimization fixes: schema, direct answers, AI-crawler access, freshness, and listing conflicts',
            'Listing citations & backlink outreach',
            'Agent-Ready (ASO) implementation — hours, offers, booking path',
            'Weekly blog content (researched & written)',
            'Full site hosting on global edge network',
            'Already paying for hosting? Drop it. Hosting is included, so that bill goes away.',
            'Unlimited site edits & updates',
            'Easy content approval workflow',
            'Google Business Profile optimization',
            'Business listing management',
            'Service-area landing pages',
            'Local SEO & citation strategy',
            'Dedicated support',
          ].map((feature) => (
            <li class="flex items-start gap-3 text-sm min-w-0">
              <span class="text-green-400 shrink-0">✓</span> <span class="min-w-0 break-words">{feature}</span>
            </li>
          ))}
        </ul>

        <a href="/signup/?plan=full_management" class="btn-primary block text-center w-full mt-auto">Get Full Management</a>
      </div>
    </div>

    <p class="mt-8 max-w-2xl mx-auto text-xs text-muted break-words">
      Rank Labs Visibility Report ($399/mo, month-to-month) is report-only: you handle all fixes, and Rank Labs makes no changes to your site.
    </p>

    <slot />
  </div>
</section>
