---
// Live chat bubble. Visitor messages relay to Telegram (@Getranklabs_bot) via
// /api/chat/*; replies come back by polling. See functions/api/_shared/chat.js
// for why Telegram and not WhatsApp.
//
// Set to E.164 digits only (no +, spaces or dashes) to show a "prefer WhatsApp"
// link alongside the chat — e.g. '13213403616'. Left empty deliberately: a
// wa.me link publishes whatever number it carries to scrapers, so this stays
// off until a number is chosen for it on purpose.
const WHATSAPP_NUMBER = '';
---

<div id="rl-chat" data-whatsapp={WHATSAPP_NUMBER}>
  <button
    type="button"
    id="rl-chat-toggle"
    class="rl-chat-toggle"
    aria-label="Open chat"
    aria-expanded="false"
    aria-controls="rl-chat-panel"
  >
    <svg class="rl-chat-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="rl-chat-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span id="rl-chat-badge" class="rl-chat-badge" hidden>1</span>
  </button>

  <section
    id="rl-chat-panel"
    class="rl-chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="rl-chat-heading"
    hidden
  >
    <header class="rl-chat-header">
      <div>
        <h2 id="rl-chat-heading">Chat with Rank Labs</h2>
        <p id="rl-chat-status" class="rl-chat-status">Ask anything — a real person answers.</p>
      </div>
      <button type="button" id="rl-chat-dismiss" class="rl-chat-dismiss" aria-label="Close chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div id="rl-chat-log" class="rl-chat-log" role="log" aria-live="polite" aria-relevant="additions"></div>

    <form id="rl-chat-away" class="rl-chat-away" hidden>
      <p>No one's picked up yet. Leave an email and you'll get a reply there.</p>
      <div class="rl-chat-away-row">
        <label class="rl-chat-sr" for="rl-chat-email">Your email</label>
        <input type="email" id="rl-chat-email" name="email" placeholder="you@company.com" required autocomplete="email" />
        <button type="submit">Send</button>
      </div>
      <p id="rl-chat-away-error" class="rl-chat-error" hidden></p>
    </form>

    <form id="rl-chat-form" class="rl-chat-composer">
      <label class="rl-chat-sr" for="rl-chat-input">Your message</label>
      <textarea id="rl-chat-input" name="message" rows="1" placeholder="Type your message…" maxlength="2000" autocomplete="off"></textarea>
      <button type="submit" id="rl-chat-send" aria-label="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>

    <p id="rl-chat-error" class="rl-chat-error" hidden></p>
    <p class="rl-chat-foot">
      <a id="rl-chat-whatsapp" href="#" hidden>Prefer WhatsApp?</a>
      <a href="mailto:hello@getranklabs.com">hello@getranklabs.com</a>
    </p>
  </section>
</div>

<!-- is:global, not Astro's default scoped styles: the message bubbles are
     created by JS at runtime, and scoped styles only rewrite selectors for
     elements present in this template at build time. Every class is rl-chat-
     prefixed instead, which is what keeps it from leaking. -->
<style is:global>
  #rl-chat {
    --rl-chat-surface: #14141f;
    --rl-chat-surface-light: #1e1e2e;
    --rl-chat-accent: #06b6d4;
    --rl-chat-muted: #94a3b8;
    --rl-chat-border: rgba(148, 163, 184, 0.18);
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    font-family: Inter, system-ui, sans-serif;
  }

  .rl-chat-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-left: auto;
    border: none;
    border-radius: 9999px;
    background: var(--rl-chat-accent);
    color: #04121a;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(6, 182, 212, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .rl-chat-toggle:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(6, 182, 212, 0.45); }
  .rl-chat-toggle:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .rl-chat-toggle svg { position: absolute; transition: opacity 0.15s ease, transform 0.15s ease; }
  .rl-chat-icon-close { opacity: 0; transform: scale(0.6) rotate(-45deg); }
  #rl-chat[data-open='true'] .rl-chat-icon-open { opacity: 0; transform: scale(0.6) rotate(45deg); }
  #rl-chat[data-open='true'] .rl-chat-icon-close { opacity: 1; transform: none; }

  .rl-chat-badge {
    position: absolute;
    top: -0.15rem;
    right: -0.15rem;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 9999px;
    background: #ef4444;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.25rem;
    text-align: center;
  }

  .rl-chat-panel {
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2.5rem));
    max-height: min(32rem, calc(100vh - 7rem));
    margin-bottom: 0.75rem;
    border: 1px solid var(--rl-chat-border);
    border-radius: 1rem;
    background: var(--rl-chat-surface);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .rl-chat-panel[hidden] { display: none; }

  .rl-chat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--rl-chat-border);
    background: var(--rl-chat-surface-light);
  }
  .rl-chat-header h2 { margin: 0; font-size: 0.95rem; font-weight: 600; color: #f1f5f9; }
  .rl-chat-status { margin: 0.15rem 0 0; font-size: 0.75rem; color: var(--rl-chat-muted); }
  .rl-chat-dismiss {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--rl-chat-muted);
    cursor: pointer;
  }
  .rl-chat-dismiss:hover { background: rgba(148, 163, 184, 0.12); color: #f1f5f9; }

  .rl-chat-log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 7rem;
    padding: 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .rl-chat-msg {
    max-width: 85%;
    padding: 0.5rem 0.75rem;
    border-radius: 0.85rem;
    font-size: 0.85rem;
    line-height: 1.45;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .rl-chat-msg-visitor { align-self: flex-end; background: var(--rl-chat-accent); color: #04121a; border-bottom-right-radius: 0.25rem; }
  .rl-chat-msg-agent { align-self: flex-start; background: var(--rl-chat-surface-light); color: #e2e8f0; border: 1px solid var(--rl-chat-border); border-bottom-left-radius: 0.25rem; }
  .rl-chat-msg-system { align-self: center; max-width: 100%; background: none; color: var(--rl-chat-muted); font-size: 0.75rem; text-align: center; }
  .rl-chat-msg-pending { opacity: 0.55; }

  .rl-chat-composer {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--rl-chat-border);
  }
  .rl-chat-composer textarea {
    flex: 1;
    max-height: 7rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--rl-chat-border);
    border-radius: 0.6rem;
    background: var(--rl-chat-surface-light);
    color: #e2e8f0;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.45;
    resize: none;
  }
  .rl-chat-composer textarea::placeholder { color: var(--rl-chat-muted); }
  .rl-chat-composer textarea:focus-visible { outline: 2px solid var(--rl-chat-accent); outline-offset: -1px; }
  .rl-chat-composer button {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 0.6rem;
    background: var(--rl-chat-accent);
    color: #04121a;
    cursor: pointer;
  }
  .rl-chat-composer button:disabled { opacity: 0.45; cursor: default; }

  .rl-chat-away { padding: 0.75rem 1rem; border-top: 1px solid var(--rl-chat-border); background: var(--rl-chat-surface-light); }
  .rl-chat-away[hidden] { display: none; }
  .rl-chat-away > p { margin: 0 0 0.5rem; font-size: 0.78rem; color: var(--rl-chat-muted); }
  .rl-chat-away-row { display: flex; gap: 0.4rem; }
  .rl-chat-away input {
    flex: 1;
    min-width: 0;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--rl-chat-border);
    border-radius: 0.5rem;
    background: var(--rl-chat-surface);
    color: #e2e8f0;
    font: inherit;
    font-size: 0.82rem;
  }
  .rl-chat-away button {
    flex-shrink: 0;
    padding: 0.45rem 0.8rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--rl-chat-accent);
    color: #04121a;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .rl-chat-error { margin: 0; padding: 0 1rem 0.6rem; font-size: 0.75rem; color: #fca5a5; }
  .rl-chat-error[hidden] { display: none; }

  .rl-chat-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0 1rem 0.75rem;
    font-size: 0.72rem;
    color: var(--rl-chat-muted);
  }
  .rl-chat-foot a { color: var(--rl-chat-muted); text-decoration: underline; text-underline-offset: 2px; }
  .rl-chat-foot a:hover { color: var(--rl-chat-accent); }
  .rl-chat-foot a[hidden] { display: none; }

  .rl-chat-sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 30rem) {
    #rl-chat { right: 1rem; bottom: 1rem; left: 1rem; }
    .rl-chat-panel { width: 100%; max-height: calc(100vh - 6.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rl-chat-toggle, .rl-chat-toggle svg { transition: none; }
    .rl-chat-toggle:hover { transform: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('rl-chat');
    if (!root) return;

    const toggle = document.getElementById('rl-chat-toggle');
    const panel = document.getElementById('rl-chat-panel');
    const dismiss = document.getElementById('rl-chat-dismiss');
    const log = document.getElementById('rl-chat-log');
    const form = document.getElementById('rl-chat-form');
    const input = document.getElementById('rl-chat-input');
    const sendBtn = document.getElementById('rl-chat-send');
    const statusEl = document.getElementById('rl-chat-status');
    const errorEl = document.getElementById('rl-chat-error');
    const badge = document.getElementById('rl-chat-badge');
    const awayForm = document.getElementById('rl-chat-away');
    const awayEmail = document.getElementById('rl-chat-email');
    const awayError = document.getElementById('rl-chat-away-error');
    const whatsapp = document.getElementById('rl-chat-whatsapp');

    const STORE = 'rl_chat';
    const STORE_TTL_MS = 24 * 60 * 60 * 1000;
    const POLL_OPEN_MS = 3000;
    const POLL_CLOSED_MS = 20000;
    // How long a visitor waits for a human before being offered the email path.
    const AWAY_AFTER_MS = 60000;
    // Mirrors IDLE_EXPIRY_MS in functions/api/_shared/chat.js: the server expires a
    // conversation after this long with no message either way, so there is no point
    // polling one past it. Measured from the last MESSAGE, not from the start of the
    // conversation — measuring from the start would cut off a chat that is still
    // going after half an hour.
    const IDLE_STOP_MS = 30 * 60 * 1000;

    // readSeq is the highest seq the visitor has actually had on screen with the
    // panel open. Without it, replaying the transcript for a returning visitor
    // would re-count answers they already read and the badge would never clear.
    let state = { id: null, token: null, code: null, lastSeq: 0, readSeq: 0, startedAt: 0, sawAgent: false, gaveEmail: false };
    let isOpen = false;
    let sending = false;
    let unread = 0;
    let pollTimer = null;
    let lastActivity = Date.now();
    const renderedSeqs = new Set();

    // ── storage (never fatal: private mode must still allow a live chat) ────
    function save() {
      try {
        localStorage.setItem(STORE, JSON.stringify({ ...state, savedAt: Date.now() }));
      } catch (e) { /* storage blocked — conversation still works for this page view */ }
    }
    function restore() {
      try {
        const raw = localStorage.getItem(STORE);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (!parsed || !parsed.id || !parsed.token) return;
        if (Date.now() - (parsed.savedAt || 0) > STORE_TTL_MS) {
          localStorage.removeItem(STORE);
          return;
        }
        state = {
          id: parsed.id,
          token: parsed.token,
          code: parsed.code || null,
          lastSeq: 0, // replay the transcript so a returning visitor sees it
          readSeq: parsed.readSeq || 0,
          startedAt: parsed.startedAt || Date.now(),
          sawAgent: !!parsed.sawAgent,
          gaveEmail: !!parsed.gaveEmail,
        };
      } catch (e) { /* unreadable — start fresh */ }
    }
    function touch() {
      lastActivity = Date.now();
    }

    function forget() {
      state = { id: null, token: null, code: null, lastSeq: 0, readSeq: 0, startedAt: 0, sawAgent: false, gaveEmail: false };
      renderedSeqs.clear();
      try { localStorage.removeItem(STORE); } catch (e) { /* nothing to clean up */ }
    }

    // First-touch attribution captured in Layout.astro, flattened to the attr_*
    // keys that functions/api/_shared/attribution.js reads.
    function attribution() {
      const out = {};
      try {
        const raw = sessionStorage.getItem('rl_attr');
        if (!raw) return out;
        const parsed = JSON.parse(raw) || {};
        for (const key of ['referrer', 'referrer_host', 'landing_page', 'utm_source', 'utm_medium', 'utm_campaign', 'gclid']) {
          if (parsed[key]) out['attr_' + key] = parsed[key];
        }
      } catch (e) { /* no attribution is survivable; a lost message is not */ }
      return out;
    }

    function track(name, params) {
      if (typeof window.gtag === 'function') {
        window.gtag('event', name, { customer_id: 'getranklabs', page_path: location.pathname, event_version: 1, ...params });
      }
    }

    // ── rendering ──────────────────────────────────────────────────────────
    function bubble(sender, body) {
      const el = document.createElement('div');
      el.className = 'rl-chat-msg rl-chat-msg-' + sender;
      el.textContent = body; // never innerHTML: bodies are visitor/operator text
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function showError(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }
    function clearError() {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    function setBadge(n) {
      unread = n;
      badge.hidden = n <= 0;
      badge.textContent = String(n);
      toggle.setAttribute('aria-label', n > 0 ? `Open chat, ${n} new message${n === 1 ? '' : 's'}` : 'Open chat');
    }

    function maybeShowAway() {
      const waited = state.startedAt && Date.now() - state.startedAt > AWAY_AFTER_MS;
      awayForm.hidden = !(isOpen && state.id && waited && !state.sawAgent && !state.gaveEmail);
    }

    // ── transport ──────────────────────────────────────────────────────────
    async function post(path, payload) {
      const resp = await fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok) throw Object.assign(new Error(data.error || 'Request failed'), { status: resp.status });
      return data;
    }

    async function tick() {
      if (!state.id || sending) return schedule();
      try {
        const url = `/api/chat/poll?id=${encodeURIComponent(state.id)}&token=${encodeURIComponent(state.token)}&after=${state.lastSeq}`;
        const resp = await fetch(url, { headers: { Accept: 'application/json' } });
        if (resp.status === 404) {
          // Expired or revoked. Drop it rather than poll a dead id forever.
          forget();
          statusEl.textContent = 'That chat expired. Send a message to start a new one.';
          return;
        }
        if (!resp.ok) return schedule();
        const data = await resp.json();
        let fresh = 0;
        for (const message of data.messages || []) {
          if (renderedSeqs.has(message.seq)) continue;
          renderedSeqs.add(message.seq);
          state.lastSeq = Math.max(state.lastSeq, message.seq);
          bubble(message.sender, message.body);
          touch();
          if (message.sender === 'agent') {
            state.sawAgent = true;
            if (message.seq > state.readSeq) fresh += 1;
          }
        }
        if (fresh) {
          statusEl.textContent = 'Connected — Josiah is replying.';
          awayForm.hidden = true;
          if (isOpen) state.readSeq = state.lastSeq;
          else setBadge(unread + fresh);
          save();
        }
        // The server decides when a conversation is over. Drop it so the next
        // message opens a fresh one, and stop polling something that is finished.
        if (data.status && data.status !== 'open') {
          bubble(
            'system',
            data.status === 'expired'
              ? 'This chat timed out after 30 minutes. Send a message to start a new one.'
              : 'This chat was closed. Send a message to start a new one.'
          );
          statusEl.textContent = 'Chat ended.';
          awayForm.hidden = true;
          forget();
          clearTimeout(pollTimer);
          return;
        }
        maybeShowAway();
      } catch (e) {
        /* transient network error: the next tick retries */
      }
      schedule();
    }

    function schedule() {
      clearTimeout(pollTimer);
      if (!state.id || document.hidden) return;
      if (Date.now() - lastActivity > IDLE_STOP_MS && !isOpen) return;
      pollTimer = setTimeout(tick, isOpen ? POLL_OPEN_MS : POLL_CLOSED_MS);
    }

    // ── actions ────────────────────────────────────────────────────────────
    // Posts one message, opening a conversation if there is not one. Returns
    // 'expired' rather than throwing when the server says this conversation timed
    // out, so the caller can drop it and open a fresh one.
    async function deliver(text) {
      try {
        if (!state.id) {
          const data = await post('/api/chat/start', {
            text,
            page_path: location.pathname,
            ...attribution(),
          });
          state.id = data.id;
          state.token = data.token;
          state.code = data.code;
          state.startedAt = Date.now();
          if (data.seq) {
            state.lastSeq = Math.max(state.lastSeq, data.seq);
            renderedSeqs.add(data.seq);
          }
          track('chat_started', {});
          statusEl.textContent = 'Sent. Josiah usually replies within a few minutes.';
        } else {
          const data = await post('/api/chat/send', { id: state.id, token: state.token, text });
          if (data.seq) {
            state.lastSeq = Math.max(state.lastSeq, data.seq);
            renderedSeqs.add(data.seq);
          }
        }
        return 'ok';
      } catch (e) {
        if (e.status === 410) return 'expired';
        throw e;
      }
    }

    async function submitMessage(text) {
      clearError();
      sending = true;
      sendBtn.disabled = true;
      const pending = bubble('visitor', text);
      pending.classList.add('rl-chat-msg-pending');

      try {
        let outcome = await deliver(text);
        if (outcome === 'expired') {
          // Recoverable. Someone coming back to a tab from this morning should get
          // a new conversation, not an error about one they never knew existed.
          forget();
          outcome = await deliver(text);
        }
        if (outcome !== 'ok') throw new Error('Could not start a new chat. Please reload the page.');
        pending.classList.remove('rl-chat-msg-pending');
        touch();
        track('chat_message_sent', {});
        save();
      } catch (e) {
        pending.remove();
        showError(e.message || 'Could not send. Email hello@getranklabs.com and it will get through.');
        input.value = text;
        autogrow();
      } finally {
        sending = false;
        sendBtn.disabled = false;
        schedule();
        maybeShowAway();
      }
    }

    function autogrow() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 112) + 'px';
    }

    function open() {
      isOpen = true;
      root.dataset.open = 'true';
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      setBadge(0);
      state.readSeq = Math.max(state.readSeq, state.lastSeq);
      save();
      if (!log.childElementCount && !state.id) {
        bubble('system', 'Ask about GEO, SEO, pricing — anything. Replies come straight to Josiah.');
      }
      input.focus();
      maybeShowAway();
      clearTimeout(pollTimer);
      if (state.id) tick();
    }

    function close() {
      isOpen = false;
      root.dataset.open = 'false';
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
      schedule();
    }

    // ── wiring ─────────────────────────────────────────────────────────────
    toggle.addEventListener('click', () => (isOpen ? close() : open()));
    dismiss.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) close();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text || sending) return;
      input.value = '';
      autogrow();
      submitMessage(text);
    });

    input.addEventListener('input', autogrow);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    awayForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      awayError.hidden = true;
      const email = awayEmail.value.trim();
      if (!email || !state.id) return;
      try {
        await post('/api/chat/email', { id: state.id, token: state.token, email, ...attribution() });
        state.gaveEmail = true;
        save();
        awayForm.hidden = true;
        bubble('system', `Thanks — a reply will go to ${email}.`);
        track('generate_lead', { form_id: 'chat', form_type: 'chat' });
      } catch (e) {
        awayError.textContent = e.message || 'Could not save that. Please try again.';
        awayError.hidden = false;
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(pollTimer);
      else if (state.id) tick();
    });

    const number = (root.dataset.whatsapp || '').replace(/\D/g, '');
    if (number) {
      whatsapp.href = `https://wa.me/${number}`;
      whatsapp.target = '_blank';
      whatsapp.rel = 'noopener';
      whatsapp.hidden = false;
    }

    restore();
    if (state.id) {
      // A returning visitor: replay the transcript into the closed panel so the
      // unread count is real, then let the badge invite them back in.
      tick();
    }
  })();
</script>
