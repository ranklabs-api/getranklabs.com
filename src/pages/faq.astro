          "@type": "Question",
          "name": "Do you check what ChatGPT or other AI assistants say about my business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "${aiReadinessHonestyLine} Live AI-answer checks, when included in a report, are clearly labeled and kept separate from the AI Optimization on-page score."
          }
        },
