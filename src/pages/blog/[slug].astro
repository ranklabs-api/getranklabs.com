const { slug } = Astro.params;
const post = posts[slug];

if (!post) {
  return Astro.redirect('/blog');
}

// Minimal markdown → HTML converter.
// Handles: h1/h2/h3, **bold**, *italic*, [links](url), - list items, --- hrules.
function renderInline(text) {
  return text
    // images: ![alt](url) — before links so the ! isn't eaten
    .replace(/!\[([^\]]+)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" loading="lazy" style="max-width:100%;height:auto;border-radius:8px;margin:2rem 0" />')
    // links: [text](url)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    // bold: **text** (before italic so ** isn't caught as *)
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    // italic: *text*
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

function renderMarkdown(md) {
  const blocks = md.trim().split('\n\n');
  const html = [];

  for (const block of blocks) {
    const trimmed = block.trim();
    if (!trimmed) continue;

    // Horizontal rule
    if (/^-{3,}$/.test(trimmed)) {
      html.push('<hr />');
      continue;
    }

    // Standalone image: ![alt](url) as its own block
    const imgMatch = trimmed.match(/^!\[([^\]]*)\]\(([^)]+)\)$/);
    if (imgMatch) {
      html.push(`<img src="${imgMatch[2]}" alt="${imgMatch[1]}" loading="lazy" style="max-width:100%;height:auto;border-radius:8px;margin:2rem 0" />`);
      continue;
    }

    // Headers
    const heading = trimmed.match(/^(#{1,3})\s+(.*)$/);
    if (heading) {
      const level = heading[1].length;
      html.push(`<h${level}>${renderInline(heading[2])}</h${level}>`);
      continue;
    }

    // Unordered list (block where every line starts with "- ")
    const lines = trimmed.split('\n');
    if (lines.every(line => /^-\s+/.test(line.trim()))) {
      const items = lines
        .map(line => `<li>${renderInline(line.trim().replace(/^-\s+/, ''))}</li>`)
        .join('');
      html.push(`<ul>${items}</ul>`);
      continue;
    }

    // Paragraph (join wrapped lines with a space)
    html.push(`<p>${renderInline(lines.join(' '))}</p>`);
  }

  return html.join('\n');
}

const postHtml = renderMarkdown(post.body);

// Derive meta description from post body (first ~155 chars)
const metaDesc = post.body
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')  // strip markdown links
  .replace(/[*#_>`]/g, '')                     // strip markdown syntax
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 155)
  .replace(/\s\S*$/, ''); // don't cut mid-word
