---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import { aiReadinessHonestyLine } from '../data/visibilityReport';
---

<Layout>

<!-- Hero -->
<section class="relative pt-28 sm:pt-32 pb-14 sm:pb-20 px-6 overflow-hidden" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_15%,rgba(99,102,241,0.14),transparent_65%)]"></div>

  <div class="max-w-4xl mx-auto text-center relative">
    <!-- Open typography gives the message room to wrap without a badge enclosure. -->
    <p class="mb-7 sm:mb-8 text-xs sm:text-sm leading-relaxed">
      <span aria-hidden="true" class="block w-8 h-px bg-purple-500 mx-auto mb-4"></span>
      <span class="block sm:inline font-semibold tracking-wide text-[#22D3EE]">SEO, Maps &amp; Get Found in AI</span>
      <span class="hidden sm:inline text-muted"> — </span>
      <span class="block sm:inline mt-1 sm:mt-0 text-muted">for local service businesses</span>
    </p>

    <h1 id="hero-title" class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.02] mb-7 sm:mb-8">
      <span class="block text-white">Get Found.</span>
      <span class="block text-[#A855F7]">Get Chosen.</span>
      <span class="block text-[#3B82F6]">Get Booked.</span>
    </h1>

    <p class="text-xl sm:text-2xl font-semibold leading-snug tracking-tight text-white max-w-2xl mx-auto">
      More calls, bookings and leads from people already looking for what you sell.
    </p>
    <p class="text-base sm:text-lg text-muted leading-relaxed max-w-xl mx-auto mt-4 mb-8">
      Rank Labs is an SEO and Get Found in AI team in Orlando, Florida. We work on the signals Google, Maps
      and AI assistants weigh when they decide which local business to show — and we report the leads we can track.
    </p>

    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center items-stretch sm:items-center">
      <a href="/contact?intent=free-audit" class="btn-primary hero-primary text-base">See If You’re Getting Found on AI <span aria-hidden="true">→</span></a>
      <a href="/#how-it-works" class="btn-secondary text-base">See How It Works</a>
      <a href="tel:+14077438964" data-call-location="hero" class="btn-ghost-call text-sm self-center"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Call (407) 743-8964</span></a>
    </div>

    <!-- Service scope and published pricing, not customer results. -->
    <dl class="grid grid-cols-2 gap-6 max-w-lg mx-auto mt-9 sm:mt-12 pt-6 border-t border-white/10">
      <div>
        <dt class="text-xs sm:text-sm text-muted">Site checks every week</dt>
        <dd class="text-lg sm:text-xl font-semibold text-white mt-1">100+</dd>
      </div>
      <div>
        <dt class="text-xs sm:text-sm text-muted">Per Month</dt>
        <dd class="text-lg sm:text-xl font-semibold text-white mt-1">From $399</dd>
      </div>
    </dl>
  </div>
</section>

<!-- Second fold — Palloma v2: two illustrated sections -->
<section id="why-found" class="py-20 sm:py-24 px-6 bg-surface/30 relative overflow-hidden" aria-labelledby="why-found-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-purple-500/5 to-cyan-500/5"></div>
  <div class="max-w-6xl mx-auto relative min-w-0">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="min-w-0 order-2 lg:order-1">
        <h2 id="why-found-title" class="text-3xl md:text-4xl font-bold mb-4 break-words">
          Your Website Exists. But Can Anyone Find It?
        </h2>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          Having a website doesn't mean your customers can find you.
        </p>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          Getting your business to show up on Google's first page, in AI-generated answers, and across other search engines takes more than just a great-looking website. It requires a comprehensive, ongoing strategy — one that has traditionally come with a big-company price tag.
        </p>
        <p class="text-white text-base sm:text-lg leading-relaxed mb-8">
          Rank Labs is changing that. We're making advanced SEO and AI search optimization affordable for local businesses.
        </p>

        <h3 class="text-2xl md:text-3xl font-bold mb-4 break-words">
          A Website Alone Isn't Enough. Here's Why.
        </h3>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          Google dominates online search. Approximately
          <span class="text-white font-medium">91%<a href="#why-found-sources" id="ref-stat-1" class="text-cyan-300 no-underline align-super text-[0.65em] font-semibold ml-0.5 hover:text-cyan-200" aria-describedby="source-1">[1]</a></span>
          of searches happen on Google, and only
          <span class="text-white font-medium">0.63%<a href="#why-found-sources" id="ref-stat-2" class="text-cyan-300 no-underline align-super text-[0.65em] font-semibold ml-0.5 hover:text-cyan-200" aria-describedby="source-2">[2]</a></span>
          of users click a result on the second page.
        </p>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          AI is changing how customers find businesses. When Google displays an AI summary, only about
          <span class="text-white font-medium">8%<a href="#why-found-sources" id="ref-stat-3" class="text-cyan-300 no-underline align-super text-[0.65em] font-semibold ml-0.5 hover:text-cyan-200" aria-describedby="source-3">[3]</a></span>
          of users click a traditional search result.
        </p>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-8">
          The bottom line? If your business isn't visible where customers are searching, you're missing a lot of opportunities and losing market share.
        </p>

        <aside id="why-found-sources" class="border-t border-white/10 pt-6" aria-label="Sources">
          <h4 class="text-xs font-mono uppercase tracking-wide text-cyan-300 mb-3">Sources</h4>
          <ol class="space-y-2 text-xs text-muted leading-relaxed list-none pl-0">
            <li id="source-1">
              <a href="#ref-stat-1" class="text-cyan-300 no-underline font-semibold mr-1">[1]</a>
              <a href="https://gs.statcounter.com/search-engine-market-share" target="_blank" rel="noopener" class="text-muted hover:text-white underline underline-offset-2">Google 91% of searches (91.05% worldwide) – StatCounter, October 2026</a>
            </li>
            <li id="source-2">
              <a href="#ref-stat-2" class="text-cyan-300 no-underline font-semibold mr-1">[2]</a>
              <a href="https://backlinko.com/google-ctr-stats" target="_blank" rel="noopener" class="text-muted hover:text-white underline underline-offset-2">0.63% of searchers click page 2 – Backlinko Google CTR study, 2025</a>
            </li>
            <li id="source-3">
              <a href="#ref-stat-3" class="text-cyan-300 no-underline font-semibold mr-1">[3]</a>
              <a href="https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/" target="_blank" rel="noopener" class="text-muted hover:text-white underline underline-offset-2">8% click rate when an AI summary appears – Pew Research Center, July 2025</a>
            </li>
          </ol>
        </aside>
      </div>

      <!-- Illustration A: website exists but is invisible in search/AI discovery -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end" aria-hidden="true">
        <svg class="w-full max-w-md h-auto" viewBox="0 0 420 360" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
          <title>Diagram: a website alone is hard to find in search and AI answers</title>
          <!-- Soft backdrop -->
          <rect x="16" y="24" width="388" height="312" rx="24" fill="#14141f" stroke="url(#a-border)" stroke-width="1.5"/>
          <defs>
            <linearGradient id="a-border" x1="16" y1="24" x2="404" y2="336" gradientUnits="userSpaceOnUse">
              <stop stop-color="#22D3EE" stop-opacity="0.55"/>
              <stop offset="1" stop-color="#A855F7" stop-opacity="0.55"/>
            </linearGradient>
            <linearGradient id="a-glow" x1="210" y1="40" x2="210" y2="200" gradientUnits="userSpaceOnUse">
              <stop stop-color="#22D3EE" stop-opacity="0.18"/>
              <stop offset="1" stop-color="#A855F7" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <ellipse cx="210" cy="120" rx="140" ry="70" fill="url(#a-glow)"/>

          <!-- Browser / site card (left) -->
          <rect x="48" y="88" width="150" height="120" rx="12" fill="#0c0c14" stroke="#22D3EE" stroke-opacity="0.45" stroke-width="1.5"/>
          <circle cx="64" cy="106" r="4" fill="#A855F7" fill-opacity="0.7"/>
          <circle cx="78" cy="106" r="4" fill="#22D3EE" fill-opacity="0.7"/>
          <circle cx="92" cy="106" r="4" fill="#3B82F6" fill-opacity="0.55"/>
          <rect x="64" y="124" width="118" height="8" rx="4" fill="#ffffff" fill-opacity="0.18"/>
          <rect x="64" y="142" width="86" height="6" rx="3" fill="#ffffff" fill-opacity="0.1"/>
          <rect x="64" y="156" width="98" height="6" rx="3" fill="#ffffff" fill-opacity="0.1"/>
          <rect x="64" y="178" width="52" height="16" rx="6" fill="#7c3aed" fill-opacity="0.55"/>

          <!-- Dashed gap / weak signal -->
          <path d="M210 148 H246" stroke="#22D3EE" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="6 6"/>
          <circle cx="228" cy="148" r="10" fill="#0c0c14" stroke="#A855F7" stroke-opacity="0.7" stroke-width="1.5"/>
          <path d="M224 148h8M228 144v8" stroke="#A855F7" stroke-opacity="0.85" stroke-width="1.5" stroke-linecap="round"/>

          <!-- Search / AI discovery panel (right) -->
          <rect x="258" y="72" width="118" height="152" rx="12" fill="#0c0c14" stroke="#A855F7" stroke-opacity="0.5" stroke-width="1.5"/>
          <rect x="274" y="92" width="86" height="10" rx="5" fill="#22D3EE" fill-opacity="0.25"/>
          <rect x="274" y="116" width="70" height="8" rx="4" fill="#ffffff" fill-opacity="0.14"/>
          <rect x="274" y="132" width="54" height="8" rx="4" fill="#ffffff" fill-opacity="0.08"/>
          <rect x="274" y="156" width="86" height="28" rx="8" fill="#22D3EE" fill-opacity="0.12" stroke="#22D3EE" stroke-opacity="0.35"/>
          <text x="317" y="174" text-anchor="middle" fill="#22D3EE" font-size="10" font-family="ui-sans-serif, system-ui, sans-serif" opacity="0.9">AI answers</text>
          <rect x="274" y="196" width="62" height="8" rx="4" fill="#ffffff" fill-opacity="0.08"/>

          <!-- Bottom caption chips (no fake stats) -->
          <rect x="64" y="248" width="120" height="28" rx="14" fill="#22D3EE" fill-opacity="0.08" stroke="#22D3EE" stroke-opacity="0.35"/>
          <text x="124" y="266" text-anchor="middle" fill="#67E8F9" font-size="11" font-family="ui-sans-serif, system-ui, sans-serif">Website live</text>
          <rect x="236" y="248" width="120" height="28" rx="14" fill="#A855F7" fill-opacity="0.1" stroke="#A855F7" stroke-opacity="0.4"/>
          <text x="296" y="266" text-anchor="middle" fill="#D8B4FE" font-size="11" font-family="ui-sans-serif, system-ui, sans-serif">Still hard to find</text>

          <!-- Magnifier accent -->
          <circle cx="348" cy="300" r="18" stroke="#22D3EE" stroke-opacity="0.55" stroke-width="2" fill="none"/>
          <path d="M360 312 L372 324" stroke="#22D3EE" stroke-opacity="0.55" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<section id="what-it-takes" class="py-20 sm:py-24 px-6 relative overflow-hidden" aria-labelledby="what-it-takes-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_20%,rgba(168,85,247,0.10),transparent_55%)]"></div>
  <div class="max-w-6xl mx-auto relative min-w-0">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
      <!-- Illustration B: ongoing SEO + AI optimization stack -->
      <div class="flex justify-center lg:justify-start" aria-hidden="true">
        <svg class="w-full max-w-md h-auto" viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
          <title>Diagram: ongoing SEO and AI optimization checklist</title>
          <defs>
            <linearGradient id="b-border" x1="20" y1="20" x2="400" y2="400" gradientUnits="userSpaceOnUse">
              <stop stop-color="#A855F7" stop-opacity="0.6"/>
              <stop offset="1" stop-color="#22D3EE" stop-opacity="0.55"/>
            </linearGradient>
            <linearGradient id="b-bar" x1="0" y1="0" x2="1" y2="0">
              <stop stop-color="#7c3aed"/>
              <stop offset="1" stop-color="#22D3EE"/>
            </linearGradient>
          </defs>
          <rect x="20" y="28" width="380" height="364" rx="24" fill="#14141f" stroke="url(#b-border)" stroke-width="1.5"/>

          <!-- Header row -->
          <rect x="48" y="56" width="160" height="12" rx="6" fill="#ffffff" fill-opacity="0.16"/>
          <rect x="48" y="78" width="96" height="8" rx="4" fill="#ffffff" fill-opacity="0.08"/>

          <!-- Checklist rows -->
          <g>
            <rect x="48" y="112" width="22" height="22" rx="6" fill="#22D3EE" fill-opacity="0.15" stroke="#22D3EE" stroke-opacity="0.55"/>
            <path d="M54 123 l4 4 8-9" stroke="#22D3EE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="84" y="116" width="180" height="10" rx="5" fill="#ffffff" fill-opacity="0.14"/>
          </g>
          <g>
            <rect x="48" y="148" width="22" height="22" rx="6" fill="#A855F7" fill-opacity="0.15" stroke="#A855F7" stroke-opacity="0.55"/>
            <path d="M54 159 l4 4 8-9" stroke="#A855F7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="84" y="152" width="150" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"/>
          </g>
          <g>
            <rect x="48" y="184" width="22" height="22" rx="6" fill="#3B82F6" fill-opacity="0.15" stroke="#3B82F6" stroke-opacity="0.55"/>
            <path d="M54 195 l4 4 8-9" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="84" y="188" width="200" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"/>
          </g>
          <g>
            <rect x="48" y="220" width="22" height="22" rx="6" fill="#22D3EE" fill-opacity="0.12" stroke="#22D3EE" stroke-opacity="0.4"/>
            <path d="M54 231 l4 4 8-9" stroke="#22D3EE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
            <rect x="84" y="224" width="132" height="10" rx="5" fill="#ffffff" fill-opacity="0.1"/>
          </g>
          <g opacity="0.75">
            <rect x="48" y="256" width="22" height="22" rx="6" fill="#A855F7" fill-opacity="0.1" stroke="#A855F7" stroke-opacity="0.35"/>
            <rect x="84" y="260" width="168" height="10" rx="5" fill="#ffffff" fill-opacity="0.08"/>
          </g>

          <!-- Ongoing monitor ring -->
          <circle cx="320" cy="168" r="54" stroke="#ffffff" stroke-opacity="0.06" stroke-width="10" fill="none"/>
          <circle cx="320" cy="168" r="54" stroke="url(#b-bar)" stroke-width="10" fill="none" stroke-linecap="round" stroke-dasharray="250 340" transform="rotate(-90 320 168)"/>
          <circle cx="320" cy="168" r="36" fill="#0c0c14" stroke="#A855F7" stroke-opacity="0.35"/>
          <text x="320" y="164" text-anchor="middle" fill="#E9D5FF" font-size="11" font-family="ui-sans-serif, system-ui, sans-serif">Weekly</text>
          <text x="320" y="180" text-anchor="middle" fill="#67E8F9" font-size="11" font-family="ui-sans-serif, system-ui, sans-serif">monitor</text>

          <!-- Bottom bars: continuous improvement metaphor -->
          <rect x="48" y="310" width="70" height="10" rx="5" fill="#7c3aed" fill-opacity="0.45"/>
          <rect x="128" y="310" width="100" height="10" rx="5" fill="#3B82F6" fill-opacity="0.45"/>
          <rect x="238" y="310" width="134" height="10" rx="5" fill="#22D3EE" fill-opacity="0.4"/>
          <text x="210" y="348" text-anchor="middle" fill="#94A3B8" font-size="12" font-family="ui-sans-serif, system-ui, sans-serif">Ongoing strategy — not one-and-done</text>
        </svg>
      </div>

      <div class="min-w-0">
        <h2 id="what-it-takes-title" class="text-3xl md:text-4xl font-bold mb-4 break-words">
          What Does It Really Take to Get Found Online?
        </h2>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          A comprehensive SEO + AI Optimization (AIO) strategy that includes:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-muted text-base sm:text-lg leading-relaxed mb-8">
          <li>Schema markup and structured data</li>
          <li>Site speed, Core Web Vitals, crawlability, indexing and internal linking</li>
          <li>Comprehensive keyword strategy</li>
          <li>Cost-based and buyer-intent keywords</li>
          <li>Content strategy, blogs and pages that answer customers' questions</li>
          <li>Service and location landing pages</li>
          <li>Google Business Profile and consistent listings across directories</li>
          <li>Getting found in ChatGPT, Gemini, Perplexity and Google's AI answers</li>
          <li>Lead tracking and calls to action that turn visits into calls and bookings</li>
          <li>Monthly ranking and traffic reports</li>
          <li>Website maintenance, security and backups, and much more</li>
        </ul>

        <h3 class="text-2xl md:text-3xl font-bold mb-4 break-words">
          SEO Isn't a One-Time Fix. It's an Ongoing Strategy.
        </h3>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          Search rankings change. Competitors evolve. AI search keeps advancing.
        </p>
        <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
          That's why Rank Labs monitors 100+ optimization factors every week, continuously working to improve your website's performance and visibility.
        </p>
        <p class="text-white text-base sm:text-lg leading-relaxed mb-10">
          Big-company SEO strategies. Local-business-friendly pricing.
        </p>

        <div class="gradient-border rounded-2xl p-6 sm:p-8 bg-gradient-to-b from-purple-500/5 to-transparent">
          <p class="text-muted text-base sm:text-lg leading-relaxed mb-4">
            More visibility means more calls, more bookings and more customers.
          </p>
          <h3 class="text-2xl font-bold mb-3 break-words">
            Is Your Website Ready to Be Found?
          </h3>
          <p class="text-muted text-base sm:text-lg leading-relaxed mb-6">
            Discover how your website performs on Google and AI-powered search platforms and uncover opportunities you could be missing.
          </p>
          <a href="/contact?intent=free-audit" class="btn-primary hero-primary text-base">Get Your FREE Get Found in AI Audit <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What We Do — Found, Chosen, Booked, Measured -->
<section id="services" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <div class="text-sm text-cyan-300 font-mono mb-4">WHAT WE DO</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Found. Chosen. Booked. Measured.</h2>
      <p class="text-muted max-w-xl mx-auto">Rankings are a means, not the goal. Everything we do is aimed at one thing: more customers contacting you.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {[
        {
          icon: '🔍',
          title: 'Found: show up where buyers already look',
          desc: 'When someone nearby needs what you do, they search Google, check Maps, or ask an AI assistant. We run 100+ checks on your site every week, fix what holds you back (on Full Management), track Google and Maps rankings for 25 keywords, and do the Get Found in AI work: schema, direct answers, AI-crawler access, and freshness.',
        },
        {
          icon: '⭐',
          title: 'Chosen: win the comparison',
          desc: 'Buyers — and the assistants answering for them — compare reviews, hours, prices and how easy you are to reach. We check your business details across 10 listing sites, trace where they conflict with your site and Maps, and (on Full Management) resolve them at the source and keep them from drifting. We also optimize your Google Business Profile (Full Management) and track reviews on Google plus one other site.',
        },
        {
          icon: '📅',
          title: 'Booked: make the next step effortless',
          desc: 'A one-tap call, a short form, or a booking link on every key page. Full Management adds service-area landing pages and an agent-ready booking path that an AI assistant can open for its user.',
        },
        {
          icon: '📈',
          title: 'Measured: see the leads we can track, not just rankings',
          desc: 'Your monthly report compares your Google search, Business Profile, traffic, and the leads we can track with last month, using your GA4, Search Console, and Business Profile data when you give us access. We tell you plainly what we can and can\'t measure yet.',
        },
      ].map((service) => (
        <div class="gradient-border rounded-xl p-6 hover:bg-surface-light/50 transition-colors">
          <div class="text-3xl mb-4">{service.icon}</div>
          <h3 class="font-semibold text-lg mb-2">{service.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-sm text-muted">
      Plus weekly SEO audits, keyword tracking, schema markup, backlink monitoring, content, and full site management.
    </p>
  </div>
</section>

<!-- Get Found in AI — how AI assistants decide who to name -->
<section id="geo" class="py-24 px-6 bg-surface/30 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-purple-500/5 to-cyan-500/5"></div>
  <div class="max-w-6xl mx-auto relative">
    <div class="text-center mb-16">
      <div class="text-sm text-cyan-300 font-mono mb-4">GET FOUND IN AI</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        How AI assistants decide<br/>
        <span class="gradient-text">who to name.</span>
      </h2>
      <p class="text-muted max-w-2xl mx-auto">
