---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import { aiReadinessHonestyLine } from '../data/visibilityReport';
---

<Layout>

<!-- Hero -->
<section class="relative pt-28 sm:pt-32 pb-14 sm:pb-20 px-6 overflow-hidden" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_15%,rgba(99,102,241,0.14),transparent_65%)]"></div>

  <div class="max-w-4xl mx-auto text-center relative">
    <!-- Open typography gives the message room to wrap without a badge enclosure. -->
    <p class="mb-7 sm:mb-8 text-xs sm:text-sm leading-relaxed">
      <span aria-hidden="true" class="block w-8 h-px bg-purple-500 mx-auto mb-4"></span>
      <span class="block sm:inline font-semibold tracking-wide text-[#22D3EE]">SEO, Maps &amp; AI Readiness</span>
      <span class="hidden sm:inline text-muted"> — </span>
      <span class="block sm:inline mt-1 sm:mt-0 text-muted">for local service businesses</span>
    </p>

    <h1 id="hero-title" class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.02] mb-7 sm:mb-8">
      <span class="block text-white">Get Found.</span>
      <span class="block text-[#A855F7]">Get Chosen.</span>
      <span class="block text-[#3B82F6]">Get Booked.</span>
    </h1>

    <p class="text-xl sm:text-2xl font-semibold leading-snug tracking-tight text-white max-w-2xl mx-auto">
      More calls, bookings and leads from people already looking for what you sell.
    </p>
    <p class="text-base sm:text-lg text-muted leading-relaxed max-w-xl mx-auto mt-4 mb-8">
      Rank Labs is an SEO and AI Readiness team in Orlando, Florida, working with local service
      businesses across the United States. We make your website and listings easy for Google, Maps
      and AI assistants to read, trust and recommend. Then we make it easy for the people who find
      you to call or book, and we report the leads we can track.
    </p>

    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center items-stretch sm:items-center">
      <a href="/contact?intent=free-audit" class="btn-primary hero-primary text-base">Get Your Free AI Readiness Audit <span aria-hidden="true">→</span></a>
      <a href="/#how-it-works" class="btn-secondary text-base">See How It Works</a>
      <a href="tel:+14077438964" data-call-location="hero" class="btn-ghost-call text-sm self-center"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Call (407) 743-8964</span></a>
    </div>

    <!-- Service scope and published pricing, not customer results. -->
    <dl class="grid grid-cols-2 gap-6 max-w-lg mx-auto mt-9 sm:mt-12 pt-6 border-t border-white/10">
      <div>
        <dt class="text-xs sm:text-sm text-muted">Site checks every week</dt>
        <dd class="text-lg sm:text-xl font-semibold text-white mt-1">100+</dd>
      </div>
      <div>
        <dt class="text-xs sm:text-sm text-muted">Per Month</dt>
        <dd class="text-lg sm:text-xl font-semibold text-white mt-1">From $499</dd>
      </div>
    </dl>
  </div>
</section>

<!-- AI Check — free audit hook -->
<section id="ai-check" class="py-20 sm:py-24 px-6 bg-surface/30 relative overflow-hidden" aria-labelledby="ai-check-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-purple-500/5 to-cyan-500/5"></div>
  <div class="max-w-4xl mx-auto text-center relative min-w-0">
    <div class="text-sm text-cyan-300 font-mono mb-4">FREE AI READINESS AUDIT</div>
    <h2 id="ai-check-title" class="text-3xl md:text-4xl font-bold mb-4 break-words">
      Is your website ready for
      <span class="gradient-text">how people find a business now?</span>
    </h2>
    <p class="text-muted max-w-xl mx-auto mb-10 break-words">
      Your next customer might search Google, check Maps, or ask an AI assistant. All three work better when your site says clearly
      who you are, what you do, where you serve, and how to book. Our free audit checks that on your actual pages and shows you what to fix first.
    </p>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-10" aria-label="What the free audit checks">
      {[
        { icon: '🧩', name: 'Schema', q: 'Does your site tell machines who you are?', color: 'text-green-400' },
        { icon: '💬', name: 'Direct answers', q: 'Do your pages answer real customer questions?', color: 'text-blue-400' },
        { icon: '🤖', name: 'AI-crawler access', q: 'Can AI crawlers read your site?', color: 'text-orange-400' },
        { icon: '🗓️', name: 'Freshness', q: 'Does your content look current, with clear dates?', color: 'text-purple-400' },
      ].map((check) => (
        <li class="gradient-border rounded-xl p-4 sm:p-5 min-w-0">
          <div class="text-2xl mb-2" aria-hidden="true">{check.icon}</div>
          <div class={`font-semibold text-sm sm:text-base ${check.color}`}>{check.name}</div>
          <div class="text-xs text-muted mt-1 break-words">{check.q}</div>
        </li>
      ))}
    </ul>

    <a href="/contact?intent=free-audit" class="btn-primary hero-primary text-base">Get Your Free AI Readiness Audit <span aria-hidden="true">→</span></a>
    <p class="text-xs text-muted mt-4 break-words">{aiReadinessHonestyLine} Free, no obligation, and we make no changes to your site.</p>
  </div>
</section>

<!-- What We Do — Found, Chosen, Booked, Measured -->
<section id="services" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <div class="text-sm text-cyan-300 font-mono mb-4">WHAT WE DO</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Found. Chosen. Booked. Measured.</h2>
      <p class="text-muted max-w-xl mx-auto">Rankings are a means, not the goal. Everything we do is aimed at one thing: more customers contacting you.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {[
        {
          icon: '🔍',
          title: 'Found: show up where buyers already look',
          desc: 'When someone nearby needs what you do, they search Google, check Maps, or ask an AI assistant. We run 100+ checks on your site every week, fix what holds you back (on Full Management), track Google and Maps rankings for 25 keywords, and raise your AI Readiness: schema, direct answers, AI-crawler access, and freshness.',
        },
        {
          icon: '⭐',
          title: 'Chosen: win the comparison',
          desc: 'Buyers compare reviews, hours, prices, and how easy you are to reach. We keep your name, address, and phone consistent across 10 listing sites, optimize your Google Business Profile (Full Management), track reviews on Google plus one other site, and compare you against 3 competitors.',
        },
        {
          icon: '📅',
          title: 'Booked: make the next step effortless',
          desc: 'A one-tap call, a short form, or a booking link on every key page. Full Management adds service-area landing pages and an agent-ready booking path that an AI assistant can open for its user.',
        },
        {
          icon: '📈',
          title: 'Measured: see the leads we can track, not just rankings',
          desc: 'Your monthly report compares your Google search, Business Profile, traffic, and the leads we can track with last month, using your GA4, Search Console, and Business Profile data when you give us access. We tell you plainly what we can and can\'t measure yet.',
        },
      ].map((service) => (
        <div class="gradient-border rounded-xl p-6 hover:bg-surface-light/50 transition-colors">
          <div class="text-3xl mb-4">{service.icon}</div>
          <h3 class="font-semibold text-lg mb-2">{service.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>

    <p class="text-center text-sm text-muted">
      Plus weekly SEO audits, keyword tracking, schema markup, backlink monitoring, content, and full site management.
    </p>
  </div>
</section>

<!-- AI Readiness — what AI assistants need -->
<section id="geo" class="py-24 px-6 bg-surface/30 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-purple-500/5 to-cyan-500/5"></div>
  <div class="max-w-6xl mx-auto relative">
    <div class="text-center mb-16">
      <div class="text-sm text-cyan-300 font-mono mb-4">AI READINESS</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        What AI assistants need<br/>
        <span class="gradient-text">from your website.</span>
      </h2>
      <p class="text-muted max-w-2xl mx-auto">
        ChatGPT, Claude, Gemini, Perplexity, and Google's AI answers all work from what they can read about you.
        We make that easy, and we score it on your pages with AI Readiness (on-page).
        Beyond that, there's one more layer, being agent-ready (ASO): publishing your hours, prices, location, reviews and booking link as data, so an AI assistant can actually choose you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      <!-- AI Readiness checklist (engine-neutral) -->
      <div class="gradient-border rounded-2xl p-6 md:p-8 bg-gradient-to-b from-purple-500/5 to-transparent md:col-span-2">
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-5">
          <div class="text-2xl font-bold">✅ AI Readiness (on-page)</div>
          <div class="text-xs text-purple-400 font-mono">What every AI assistant reads</div>
        </div>
        <ol class="space-y-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6">
          {[
            { step: '01', label: 'Clear page descriptions', desc: 'Every page has a concise, accurate title and meta description.' },
            { step: '02', label: 'Structured data', desc: 'Organization, LocalBusiness, and FAQ schema, so machines know who you are, where you serve, and what you offer.' },
            { step: '03', label: 'Direct-answer content', desc: 'Services, locations, FAQs, and prices written as clear answers.' },
            { step: '04', label: 'AI-crawler access', desc: 'GPTBot, ClaudeBot, PerplexityBot, and Google-Extended allowed in robots.txt.' },
            { step: '05', label: 'Consistent business facts', desc: 'The same name, address, and phone on your site and your listings.' },
            { step: '06', label: 'Fresh content', desc: 'Current information and clear publish dates.' },
            { step: '07', label: 'Fast, mobile-friendly pages', desc: 'Speed and Core Web Vitals checked every week.' },
          ].map((item) => (
            <li class="flex gap-3 text-sm">
              <span class="text-purple-400 font-mono text-xs shrink-0 mt-0.5">{item.step}</span>
              <div>
                <div class="font-medium text-white text-sm">{item.label}</div>
                <div class="text-muted text-sm leading-relaxed mt-0.5">{item.desc}</div>
              </div>
            </li>
          ))}
        </ol>
        <p class="text-xs text-muted mt-4">{aiReadinessHonestyLine}</p>
      </div>

      <!-- Agent-Ready (ASO) -->
      <div class="gradient-border rounded-2xl p-6 md:p-8 bg-gradient-to-b from-cyan-500/5 to-transparent md:col-span-2">
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-5">
          <div class="text-2xl font-bold">🎯 Agent-Ready (ASO)</div>
          <div class="text-xs text-cyan-400 font-mono">Agentic Search Optimization · make it easy for an AI assistant to pick you</div>
        </div>
        <p class="text-sm text-muted mb-4">Make it easy for an AI assistant to pick you and start a booking. When an assistant is asked to find an open business and start a booking, it needs your hours, prices, location, reviews and booking link as machine-readable data.</p>
        <ol class="space-y-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6">
          {[
            { step: '01', label: 'Machine-Readable Hours & Location', desc: 'Your hours, address and coordinates as structured data — so an agent can tell if you\'re open and where to send a customer.' },
            { step: '02', label: 'Exact-Price Service Menu', desc: 'Every service listed with a real price, not a range — "$1,275" beats "affordable."' },
            { step: '03', label: 'Reviews & Ratings Marked Up', desc: 'Your rating and reviews as data an AI can read and attribute to you.' },
            { step: '04', label: 'Verified Profile Connections', desc: 'Your Google, Instagram and directory profiles linked to your site, so AI cross-references your identity.' },
            { step: '05', label: 'Machine-Reachable Booking Entry Point', desc: 'A stable, deep-linkable booking or enquiry page an agent can open for its user.' },
            { step: '06', label: 'Availability / Next-Available Signal', desc: 'A machine-readable "next available" signal, so an agent picks you when it can verify you have openings.' },
          ].map((item) => (
            <li class="flex gap-3 text-sm">
              <span class="text-cyan-400 font-mono text-xs shrink-0 mt-0.5">{item.step}</span>
              <div>
                <div class="font-medium text-white text-sm">{item.label}</div>
                <div class="text-muted text-sm leading-relaxed mt-0.5">{item.desc}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Why now -->
    <div class="max-w-4xl mx-auto">
      <div class="text-center">
        <h3 class="text-xl font-bold mb-2">Why now</h3>
        <p class="text-muted text-sm">People are starting to ask AI assistants for recommendations as well as searching Google. The groundwork is the same for both: clear facts, real answers, a site machines can read. The businesses that do it early are easier to recommend.</p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section id="how-it-works" class="py-24 px-6 bg-surface/30">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <div class="text-sm text-cyan-300 font-mono mb-4">HOW IT WORKS</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">From search to booked customer, in four steps</h2>
      <p class="text-muted">No complicated onboarding. No endless meetings. Just steady work you can see.</p>
    </div>

    <div class="space-y-8">
      {[
        { step: '01', title: 'Found', desc: 'Show us your site. We audit it and your listings: 100+ SEO checks plus your AI Readiness (on-page) score. Your first report arrives within 24 hours. Existing site? We\'ll migrate it with no downtime.' },
        { step: '02', title: 'Chosen', desc: 'We fix what makes you hard to pick: missing facts, inconsistent listings, weak review signals, unclear services and prices. On Full Management we do the fixes; on the Visibility Report you get a prioritized list.' },
        { step: '03', title: 'Booked', desc: 'We make it easy to act on every key page: one-tap call, short form, booking link, and a path an AI assistant can open.' },
        { step: '04', title: 'Measured', desc: 'Every week you see what changed. Every month you see your search, Business Profile, traffic, and the leads we can track against last month, in plain English. When something can\'t be measured yet, we say so.' },
      ].map((item) => (
        <div class="flex gap-6 items-start">
          <div class="text-4xl font-bold gradient-text font-mono shrink-0">{item.step}</div>
          <div>
            <h3 class="font-semibold text-xl mb-2">{item.title}</h3>
            <p class="text-muted">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Results -->
<section id="results" class="py-24 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <div class="text-sm text-cyan-300 font-mono mb-4">THE RESULTS</div>
    <h2 class="text-3xl md:text-4xl font-bold mb-4">What Your Business Gets</h2>
    <p class="text-muted mb-16 max-w-xl mx-auto">
      Weekly work you can see, reported in plain English, without agency overhead.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {[
        { value: '24h', label: 'Your first audit report' },
        { value: '100+', label: 'Site checks every week' },
        { value: 'Weekly', label: 'Updates & Optimizations' },
        { value: 'Month-to-month', label: 'Visibility Report plan', small: true },
      ].map((stat) => (
        <div>
          <div class={`${stat.small ? 'text-2xl' : 'text-3xl'} font-bold gradient-text mb-1`}>{stat.value}</div>
          <div class="text-sm text-muted">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Reviews -->
<!--
  Real Google reviews, shown as visible text with attribution and a link to the
  source. Deliberately NO aggregateRating / Review JSON-LD: these are reviews
  about Rank Labs on Rank Labs' own site, which is the self-serving case Google
  excludes from review rich results — marking them up would earn no stars and
  would be the thing we flag in a client audit.

  Visible text is what the AI engines read anyway, which is the point here.

  The quote is the review in full. Google's UI truncates the ColonoscopyKC
  one with a "More" link; the complete text was supplied by Josiah on
  2026-10-28. Quote these verbatim — do not trim, paraphrase or embellish a
  customer's words.

  Attributed to the business, not the individual reviewer, at Josiah's request
  (2026-10-28). The review text itself is unchanged.
-->
<section id="reviews" class="py-24 px-6 bg-surface/30" aria-labelledby="reviews-title">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <div class="text-sm text-cyan-300 font-mono mb-4">WHAT CLIENTS SAY</div>
      <h2 id="reviews-title" class="text-3xl md:text-4xl font-bold mb-4">Reviewed on Google</h2>
      <p class="text-muted">
        <span class="text-yellow-400" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="text-white font-semibold">5.0</span> from 2 reviews on
        <a href="https://maps.google.com/?cid=5154801530457218648" rel="noopener" class="text-cyan-400 hover:text-cyan-300">Google</a>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 max-w-2xl mx-auto">
      {[
        {
          quote: "At ColonoscopyKC.com, Rank Labs has made a real difference for our business. We only started working with them a little over a month ago, and we’re already seeing results. After working with them on our online and AI search visibility, we received 5 colonoscopy consultation requests in about a week, plus another inquiry directly through our website. It’s exciting to see the work translate into actual new patient opportunities. Josiah has been incredibly dedicated to helping us grow, and we highly recommend Rank Labs.",
          author: 'ColonoscopyKC.com',
        },
      ].map((r) => (
        <figure class="bg-surface/60 border border-white/10 rounded-xl p-6 text-left">
          <div class="text-yellow-400 text-sm mb-3" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote class="text-muted leading-relaxed mb-4">
            &ldquo;{r.quote}&rdquo;
          </blockquote>
          <figcaption class="text-sm">
            <span class="text-white font-semibold">{r.author}</span>
            <span class="text-muted"> &middot; Google review</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Pricing -->
<Pricing>
    <!-- Site Builds -->
    <div class="mt-16 max-w-lg mx-auto">
      <div class="text-sm text-cyan-300 font-mono mb-2">ONE-TIME</div>
      <h3 class="text-xl font-bold mb-2">Site Builds & Migration</h3>
      <p class="text-muted text-sm mb-6">Custom sites on a global edge network. Or bring your existing site — we'll migrate it seamlessly.</p>
      <div class="space-y-3 text-left">
        {[
          { pages: 'Landing Page', price: '$1,250', desc: 'Single-page site. Perfect for product launches or lead gen.' },
          { pages: 'Up to 5 Pages', price: '$2,500', desc: 'Home, About, Services, Blog, Contact — the full stack.' },
          { pages: 'Site Migration', price: '$1,000', desc: 'Moving from Wix, Squarespace, WordPress? We handle DNS, content, and redirects without downtime.' },
          { pages: '6+ Pages', price: 'Custom', desc: 'Complex sites, e-commerce, dashboards. Let\'s talk.' },
        ].map((tier) => (
          <div class="flex items-center justify-between gap-4 gradient-border rounded-xl p-4 min-w-0">
            <div class="min-w-0">
              <div class="font-semibold text-sm">{tier.pages}</div>
              <div class="text-xs text-muted break-words">{tier.desc}</div>
            </div>
            <div class="text-lg font-bold gradient-text shrink-0">{tier.price}</div>
          </div>
        ))}
      </div>
      <a href="/contact" class="btn-secondary inline-block mt-8">Tell Us What You Need →</a>
    </div>
</Pricing>

<!-- CTA -->
<section class="py-24 px-6">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready for more calls from people already looking?</h2>
    <p class="text-muted mb-4">
      Get a free AI Readiness audit of your website: what helps Google, Maps and AI assistants understand
      and recommend you, what's missing, and what to fix first.
    </p>
    <p class="text-xs text-muted mb-8">{aiReadinessHonestyLine}</p>
    <a href="/contact?intent=free-audit" class="btn-primary text-lg">Get My Free AI Readiness Audit →</a>
    <a href="tel:+14077438964" data-call-location="cta" class="btn-primary block mt-5">Call (407) 743-8964</a>
  </div>
</section>

</Layout>

<style>
  /* Homepage-only brand ground; shared pages retain their existing styling. */
  :global(body) {
    background-color: #0A0F17;
    color: #FFFFFF;
  }

  .hero-primary {
    background-image: linear-gradient(135deg, #A855F7, #3B82F6);
  }

  .hero-primary:hover {
    background-image: linear-gradient(135deg, #8B5CF6, #3B82F6);
  }

  section[id] {
    scroll-margin-top: 5rem;
  }
</style>
