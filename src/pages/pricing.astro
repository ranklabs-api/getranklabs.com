---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import ReportFeatures from '../components/ReportFeatures.astro';
import { aiReadinessHonestyLine } from '../data/visibilityReport';
---

<Layout title="Pricing — SEO & Get Found in AI Plans — Rank Labs" description="Rank Labs pricing: Visibility Report $399/mo (month-to-month, SEO + Get Found in AI, report only) or Full Management $1,249/mo (we do the work).">
  <div class="pt-16">
    <Pricing headingLevel="h1">
      <div id="visibility-report-scope" class="mt-16 max-w-4xl mx-auto gradient-border rounded-2xl p-6 sm:p-8 text-left scroll-mt-20">
        <div class="text-sm text-purple-300 font-mono mb-2">$399/MO · MONTH-TO-MONTH · REPORT ONLY</div>
        <h2 class="text-2xl font-bold mb-2 break-words">Everything in the Rank Labs Visibility Report</h2>
        <p class="text-sm text-muted mb-8 break-words">SEO + Get Found in AI (on-page) in one report. You handle all fixes — Rank Labs makes no changes to your site.</p>
        <ReportFeatures />
        <p class="text-xs text-muted mt-6 break-words">{aiReadinessHonestyLine}</p>
      </div>

      <p class="mt-12 text-sm text-muted">
        <a href="/services" class="text-cyan-400 hover:underline">See the full service breakdown →</a>
        &nbsp;·&nbsp;
        <a href="/faq" class="text-cyan-400 hover:underline">Read our FAQ →</a>
      </p>
    </Pricing>
  </div>
</Layout>
