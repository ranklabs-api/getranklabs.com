          "priceRange": "$1,500–$2,500",
          "paymentAccepted": "Credit Card",
          "currenciesAccepted": "USD",
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "17:00"
          },
          "sameAs": [
            "https://www.instagram.com/getranklabs/",
            "https://www.facebook.com/1087723997765715",
            "https://business.foursquare.com/places/6a8346855105fe595ede6784",
            "https://maps.google.com/?cid=12023381141749028916"
          ],
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "contactType": "sales",
              "telephone": "+19133758995",
              "email": "hello@getranklabs.com",
              "availableLanguage": "en",
              "hoursAvailable": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "09:00",
                "closes": "17:00"
              }
            },
            {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "telephone": "+19133758995",
              "email": "hello@getranklabs.com",
              "availableLanguage": "en"
            }
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Marketing Services",
            "itemListElement": [
              {
