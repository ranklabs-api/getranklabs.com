---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title = 'Rank Labs — Get Found on ChatGPT, Claude, Gemini & Perplexity', description = 'GEO and SEO platform from Josiah and Palloma: weekly audits, blog content, keyword tracking, and full-site management without agency overhead.', image = '/og-image.png' } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'website' : 'article'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Rank Labs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Rank Labs",
      "url": "https://getranklabs.com",
      "logo": "https://getranklabs.com/logo.svg",
      "description": "Get your business found on ChatGPT, Claude, Gemini, and Perplexity. AI-first search optimization with stronger Google rankings as a side effect.",
      "sameAs": [
        "https://www.instagram.com/getranklabs/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "hello@getranklabs.com"
      }
    }`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
      <meta name="google-site-verification" content="lJONT2vSm_2eo-t6UPvChwHYHpwgpoLhC69BHnTAYyM" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4D52285Z1C"></script>
    <!-- is:inline is REQUIRED. Without it Astro bundles this as
         <script type="module"> and minifies the function name, so `gtag` is
         module-scoped under a mangled name and `window.gtag` is undefined.
         Every custom event guarded by `typeof window.gtag === 'function'`
         (lead submissions, call-click tracking) then silently never fires,
         while pageviews keep working because those come from gtag/js itself.
         window.gtag is also assigned explicitly so the global survives any
         future bundling change. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-4D52285Z1C');
    </script>
    <!-- First-touch attribution capture.
         Deliberately uses ONLY document.referrer / location / sessionStorage —
         no gtag, no third-party request. A blocked visitor still gets captured,
         which is the entire point: on 2026-09-03 a real lead arrived from
         someone GA4 never saw (no session, no pageview, no event), so its source
         was unrecoverable. The form POSTs this to our own function.
         is:inline for the same reason as the block above — bundling would scope
         it to a module and it must run before any navigation.
         Written once per tab and never overwritten, so browsing / -> /contact
         still reports the ORIGINAL source rather than an internal referrer. -->
    <script is:inline>
      (function () {
        try {
          var KEY = 'rl_attr';
          if (sessionStorage.getItem(KEY)) return;
          var host = location.hostname.replace(/^www\./, '');
          var ref = document.referrer || '';
          var refHost = '', refClean = '';
          if (ref) {
            try {
              var u = new URL(ref);
              refHost = u.hostname.replace(/^www\./, '');
              refClean = u.origin + u.pathname;
            } catch (e) {}
          }
          if (refHost === host) { refHost = ''; refClean = ''; }
          var p = new URLSearchParams(location.search);
          sessionStorage.setItem(KEY, JSON.stringify({
            referrer: refClean,
            referrer_host: refHost,
            landing_page: location.pathname,
            utm_source: p.get('utm_source') || '',
            utm_medium: p.get('utm_medium') || '',
            utm_campaign: p.get('utm_campaign') || '',
            gclid: p.get('gclid') || ''
          }));
        } catch (e) { /* private mode / storage disabled — form still submits */ }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest('a[href^="tel:"]') : null;
        if (!link) return;

        if (typeof window.gtag === 'function') {
          window.gtag('event', 'click_to_call', {
            customer_id: 'getranklabs',
            link_location: link.getAttribute('data-call-location') || 'unknown',
            page_path: window.location.pathname,
            event_version: 1,
            transport_type: 'beacon',
          });
        }
      });
    </script>
  </body>
</html>
